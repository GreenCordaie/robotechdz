# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  E2E Test environment — STACK ISOLÉE                                     ║
# ║  ⚠️ Ces clés sont fictives. Le test DB tourne sur localhost:5433.       ║
# ║  Aucune valeur ici n'est utilisée en prod.                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

NODE_ENV=development

# DB et cache locaux Docker
DATABASE_URL=postgres://testuser:testpass@localhost:5499/pc_ia_test
REDIS_URL=redis://localhost:6499

# Auth (valeurs FIXES pour reproductibilité — JAMAIS utiliser en prod)
SESSION_SECRET=test_session_secret_e2e_only_NEVER_USE_IN_PROD_xxx
ENCRYPTION_KEY=test_encryption_key_e2e_only_NEVER_USE_IN_PROD_xxx

# Upstash Redis : on désactive en pointant nulle part — RateLimitService
# fail-closed mais en dev ça throw, donc on met une URL bidon pour qu'il
# court-circuite. La rate-limit ne sera pas testée ici.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Toutes les clés externes VIDES → les services court-circuitent (pas d'appel)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
N8N_CALLBACK_SECRET=test_n8n_callback_secret_xxx
N8N_WEBHOOK_URL=
LOADBRAIN_API_KEY=
LOADBRAIN_BASE_URL=
LOADBRAIN_SITE_URL=
LOADBRAIN_WEBHOOK_SECRET=test_loadbrain_webhook_secret_xxx
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
GROQ_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@e2e.local

CRON_SECRET=test_cron_secret_xxx
PRINT_SECRET=test_print_secret_xxx

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_DEBUG_ROUTES=false
