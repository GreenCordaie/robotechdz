# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  100-pc-IA / Robotech Admin / FLEXBOX DIRECT — Environment variables     ║
# ║  Génère les secrets avec : openssl rand -hex 32                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@localhost:5432/flexbox"

# ─── Cache / Queue (REQUIRED for BullMQ workers) ─────────────────────────────
REDIS_URL="redis://localhost:6379"

# Upstash Redis (REQUIRED pour rate-limit + cache Edge)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Auth & Encryption (REQUIRED) ────────────────────────────────────────────
SESSION_SECRET="change_me_generate_with_openssl_rand_hex_32"
ENCRYPTION_KEY="change_me_generate_with_openssl_rand_hex_32"
# ⚠️ ENCRYPTION_KEY doit rester STABLE — un changement rend illisibles tous
#    les codes/refresh-tokens/MFA déjà chiffrés en DB.

# Cloudflare Turnstile (CAPTCHA login admin + reseller)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ─── Print Service ───────────────────────────────────────────────────────────
PRINT_SECRET="change_me_generate_with_openssl_rand_hex_32"

# ─── Telegram Bot (notifications admin/caisse/traiteur) ──────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SECRET_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── WhatsApp (Waha gateway) ─────────────────────────────────────────────────
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_SESSION=""
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# ─── n8n Automation ──────────────────────────────────────────────────────────
N8N_CALLBACK_SECRET=""
N8N_WEBHOOK_URL=""

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
CRON_SECRET="change_me_generate_with_openssl_rand_hex_32"

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── LoadBrain (provisioning IPTV/services) ──────────────────────────────────
LOADBRAIN_API_KEY=""
LOADBRAIN_BASE_URL=""
LOADBRAIN_SITE_URL=""
LOADBRAIN_WEBHOOK_SECRET=""

# ─── Microsoft Graph (Outlook/Netflix resolver) ──────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI=""
# Multi-app support (compte Microsoft #2 pour fallback)
MICROSOFT_CLIENT_ID_2=""
MICROSOFT_CLIENT_SECRET_2=""

# ─── AI Chatbot (Groq, malgré le nom du fichier "gemini.ts") ─────────────────
GROQ_API_KEY=""

# ─── Web Push (notifications PWA) ────────────────────────────────────────────
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ─── Debug routes (production = false) ───────────────────────────────────────
# Mettre à "true" UNIQUEMENT en dev/staging pour activer /api/debug-codes etc.
ENABLE_DEBUG_ROUTES="false"

# ─── Node env ────────────────────────────────────────────────────────────────
NODE_ENV="production"
