# ============================================================
# 100-pc-IA / ROBOTECHDZ — Environment configuration
#
# This file is the SOURCE OF TRUTH for every variable the app
# reads. Copy to .env.development.local for local dev, or to
# .env for production. Comments document what each var does,
# whether it's required, and where to obtain the value.
#
# Tags:
#   [REQUIRED]   app crashes or critical path breaks if missing
#   [OPTIONAL]   feature degrades gracefully
#   [DB-FIRST]   value lives in shop_settings DB; env is fallback
#                only — most operators set these from /admin/settings
#   [DEPRECATED] kept for backwards compat, will be removed
#
# Last consolidated: 2026-05-27. Generated by env-audit pass.
# Generate random secrets with: openssl rand -hex 32
# ============================================================


# ─── 1. Core ─────────────────────────────────────────────────
NODE_ENV=development                          # [REQUIRED] development | production | test
# PORT is hardcoded in package.json (1556 dev). The runtime also
# accepts -p flag (we use 3050 locally).


# ─── 2. Database (Postgres + Redis) ──────────────────────────
DATABASE_URL=                                 # [REQUIRED] e.g. postgresql://user:password@localhost:5435/flexbox

# Local Redis (BullMQ workers + EventBus). Mutually exclusive with
# Upstash below — set ONE strategy.
REDIS_URL=redis://localhost:6379              # [OPTIONAL] full Redis URL

# Upstash REST Redis (used by /lib/redis.ts). When set, takes
# precedence over REDIS_URL for the REST-API path.
UPSTASH_REDIS_REST_URL=                       # [OPTIONAL] https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=                     # [OPTIONAL] paired token


# ─── 3. App URLs ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3050     # [REQUIRED] public origin of THIS app (used in webhook + deeplink URLs)
NEXT_PUBLIC_BASE_URL=                         # [OPTIONAL] legacy alias of NEXT_PUBLIC_APP_URL, used by /admin/monitoring
PUBLIC_URL=                                   # [OPTIONAL] another legacy alias (shared accounts module)
NEXTAUTH_URL=                                 # [OPTIONAL] only if NextAuth is enabled (currently unused)


# ─── 4. Crypto / auth ────────────────────────────────────────
SESSION_SECRET=                               # [REQUIRED] HMAC key for JWT session cookies (min 32 chars random)
ENCRYPTION_KEY=                               # [REQUIRED] AES-256-GCM key for credentials at rest (min 32 chars random)
                                              # Falls back to SESSION_SECRET if unset (NOT recommended in prod).


# ─── 5. Cron / reconciler ────────────────────────────────────
CRON_SECRET=                                  # [REQUIRED] header value (x-cron-secret) for admin reconciler endpoints
RECONCILER_SECRET=                            # [OPTIONAL] alias of CRON_SECRET checked by IPTV + G2Bulk reconciler routes
N8N_CALLBACK_SECRET=                          # [OPTIONAL] HMAC for /api/admin/n8n/callback


# ─── 6. LoadBrain gateway (IPTV + G2Bulk + Kinguin) ──────────
LOADBRAIN_URL=https://api.loadbrain.shop      # [REQUIRED] gateway base URL — DO NOT use LOADBRAIN_BASE_URL (legacy)
LOADBRAIN_API_KEY=                            # [REQUIRED] X-API-Key — see https://api.loadbrain.shop/admin/api-keys
LOADBRAIN_WEBHOOK_SECRET=                     # [REQUIRED] HMAC secret for incoming gateway webhooks
LOADBRAIN_SITE_URL=                           # [OPTIONAL] our public site URL used by LB redirects (defaults to NEXT_PUBLIC_APP_URL)
LOADBRAIN_USE_V2=true                         # [OPTIONAL] true → use SDK v2 endpoints; false → legacy lbClient
LOADBRAIN_INTERNAL_TOKEN=                     # [REQUIRED] shared X-Internal-Token used by LoadBrain → boutique calls (centralised WhatsApp, auto-approve, balance-fetcher lb_module)
LOADBRAIN_SITE_ID=AGENT007                    # [REQUIRED] this boutique's site id registered in LoadBrain (AGENT007 = 100-pc-IA)


# ─── 7. Microsoft Graph (Netflix mailbox watcher) ────────────
# [DB-FIRST] These also live in shop_settings.microsoft_* — env values
# are fallbacks. Used by streaming-mailbox-watcher worker to read
# Outlook inbox for OTP / household codes.
MICROSOFT_CLIENT_ID=                          # primary app registration client id
MICROSOFT_CLIENT_SECRET=                      # primary app registration secret
MICROSOFT_CLIENT_ID_2=                        # [OPTIONAL] secondary app for round-robin
MICROSOFT_CLIENT_SECRET_2=                    # [OPTIONAL] paired secret


# ─── 8. WhatsApp (WAHA + Evolution API) ──────────────────────
# [DB-FIRST] Operator sets these via /admin/settings; env is fallback.
WHATSAPP_API_URL=                             # WAHA base URL (e.g. https://waha.nexusbox.tech)
WHATSAPP_API_KEY=                             # WAHA API key (header X-Api-Key)
WAHA_API_URL=                                 # [LEGACY] same as WHATSAPP_API_URL — used by n8n.service.ts fallback
WHATSAPP_WEBHOOK_SECRET=                      # [REQUIRED if WhatsApp inbound used] HMAC for /api/loadbrain/webhook


# ─── 9. Telegram bot (admin alerts) ──────────────────────────
# [DB-FIRST] Bot token + chat IDs live in shop_settings.telegram_*.
# Only the secret_token below is env-only (Telegram webhook verification).
TELEGRAM_SECRET_TOKEN=                        # [OPTIONAL] header X-Telegram-Bot-Api-Secret-Token


# ─── 10. n8n workflow engine ─────────────────────────────────
N8N_WEBHOOK_URL=                              # [OPTIONAL] e.g. https://n8n.nexusbox.tech/webhook/flexbox-gateway


# ─── 11. Cloudflare Turnstile (CAPTCHA on logins) ────────────
TURNSTILE_SECRET_KEY=                         # [OPTIONAL] backend verification key (cloudflare dashboard)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=               # [OPTIONAL] frontend widget key (exposed to client)


# ─── 12. R2 object storage (Cloudflare) ──────────────────────
# Used for product image uploads, logos, etc. All required together
# if any image upload feature is used; otherwise all optional.
R2_ACCOUNT_ID=                                # [OPTIONAL] e.g. abc123def
R2_ACCESS_KEY_ID=                             # [OPTIONAL]
R2_SECRET_ACCESS_KEY=                         # [OPTIONAL]
R2_BUCKET_NAME=                               # [OPTIONAL]
R2_PUBLIC_URL=                                # [OPTIONAL] e.g. https://pub-xyz.r2.dev
R2_ENDPOINT=                                  # [OPTIONAL] e.g. https://<accountid>.r2.cloudflarestorage.com


# ─── 13. Local print service ─────────────────────────────────
PRINT_SERVICE_URL=http://127.0.0.1:6543       # [OPTIONAL] kiosk receipt printer daemon
PRINT_SECRET=                                 # [OPTIONAL] HMAC for print jobs (CHANGE the default!)


# ─── 14. Streaming deeplink mode ─────────────────────────────
STREAMING_DEEPLINK_MODE=                      # [OPTIONAL] "true" to enable mailbox watcher worker (boots on `register`)


# ─── 15. Debug routes ────────────────────────────────────────
ENABLE_DEBUG_ROUTES=                          # [OPTIONAL] "true" to expose /api/debug-codes etc in prod (DANGEROUS — leave unset)


# ─── 16. Future / placeholder (declared but currently unread) ─
# Kept here so operators know they're not lost — code may start reading
# them again. Safe to leave empty.
VAPID_PUBLIC_KEY=                             # [FUTURE] Web Push notifications
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GROQ_API_KEY=                                 # [FUTURE] referenced in legacy example, not currently consumed
TELEGRAM_BOT_TOKEN=                           # [DB-FIRST] kept for migration scripts only
TELEGRAM_CHAT_ID=
WHATSAPP_SESSION=                             # [FUTURE] direct Baileys session (currently we use WAHA HTTP)
WHATSAPP_VERIFY_TOKEN=                        # [DB-FIRST] also in shop_settings.whatsapp_verify_token
MICROSOFT_REDIRECT_URI=                       # [LEGACY] now computed from NEXT_PUBLIC_APP_URL
MICROSOFT_TENANT_ID=                          # [LEGACY] now picked from shop_settings


# ─── 17. Production-only extras ──────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=                      # [OPTIONAL] cloudflared tunnel auth
DB_PASSWORD=                                  # [LEGACY] embedded in DATABASE_URL — remove if your DATABASE_URL already has it
N8N_PUBLIC_URL=                               # [OPTIONAL] public-facing n8n URL


# ============================================================
# Settings NOT in env (live in shop_settings DB)
# ============================================================
# - Telegram bot token / chat IDs (telegram_bot_token, telegram_chat_id_*)
# - WhatsApp instance config (whatsapp_instance_name, whatsapp_sender_number,
#   whatsapp_message_template, whatsapp_webhook_url, whatsapp_verify_token)
# - Gemini API key (gemini_api_key) — chatbot
# - Chatbot config (chatbot_enabled, chatbot_greeting, chatbot_role)
# - Microsoft Graph creds (microsoft_client_id, microsoft_client_secret,
#   microsoft_tenant_id, microsoft_redirect_uri) — env values are fallback
# - Netflix shared-account resolver creds (netflix_resolver_email,
#   netflix_resolver_password)
# - Shop branding (shop_name, logo_url, accent_color, etc.)
#
# Admin UI at /admin/settings is the single source of truth.
# If a value is set in BOTH env and DB, the DB wins.
