# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@localhost:5432/flexbox"

# ─── Cache / Queue ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth & Encryption (REQUIRED — generate with: openssl rand -hex 32) ─────
SESSION_SECRET="change_me_generate_with_openssl_rand_hex_32"
ENCRYPTION_KEY="change_me_generate_with_openssl_rand_hex_32"

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ─── Print Service ───────────────────────────────────────────────────────────
PRINT_SECRET="change_me_generate_with_openssl_rand_hex_32"

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SECRET_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── WhatsApp (Waha) ─────────────────────────────────────────────────────────
WHATSAPP_API_URL=""
WHATSAPP_SESSION=""
WHATSAPP_WEBHOOK_SECRET=""

# ─── N8N Automation ──────────────────────────────────────────────────────────
N8N_CALLBACK_SECRET=""
N8N_WEBHOOK_URL=""

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
CRON_SECRET="change_me_generate_with_openssl_rand_hex_32"

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── Node env ────────────────────────────────────────────────────────────────
NODE_ENV="production"
