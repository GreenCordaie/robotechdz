# ═══════════════════════════════════════════════════════════════════════════════
# ROBOTECH — Production Environment (.env.production)
# Copier ce fichier en .env.production et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Base de données (interne Docker — ne pas changer) ───────────────────────
DATABASE_URL="postgresql://flexbox_user:CHANGE_ME_STRONG_PASSWORD@db:5432/flexbox"
DB_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ─── Redis (interne Docker) ──────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─── Upstash Redis (rate limiting Edge) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Sécurité ────────────────────────────────────────────────────────────────
SESSION_SECRET="GENERATE_WITH: openssl rand -hex 32"
ENCRYPTION_KEY="GENERATE_WITH: openssl rand -hex 32"
CRON_SECRET="GENERATE_WITH: openssl rand -hex 32"
N8N_CALLBACK_SECRET="GENERATE_WITH: openssl rand -hex 32"
PRINT_SECRET="GENERATE_WITH: openssl rand -hex 16"
WHATSAPP_WEBHOOK_SECRET="abc"

# ─── URLs publiques ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://boutique.nexusbox.tech"
N8N_PUBLIC_URL="https://n8n.nexusbox.tech"
N8N_WEBHOOK_URL="https://n8n.nexusbox.tech/webhook/flexbox-gateway"

# ─── WAHA (WhatsApp) ────────────────────────────────────────────────────────
WAHA_API_KEY="abc"
WHATSAPP_API_URL="http://whatsapp:3000/api"

# ─── Microsoft Graph API ────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID="your-client-id"
MICROSOFT_CLIENT_ID_2="your-secondary-client-id"
MICROSOFT_CLIENT_SECRET_2="your-client-secret"

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret"

# ─── Cloudflare R2 (Storage) ────────────────────────────────────────────────
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="image"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ─── Cloudflare Tunnel ──────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN="your-tunnel-token-from-cloudflare-dashboard"

# ─── Node.js ─────────────────────────────────────────────────────────────────
NODE_OPTIONS="--dns-result-order=ipv4first"
